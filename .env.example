# Copy this file to .env and fill in what you have. Everything here is optional —
# the bot runs and connects to WhatsApp with zero keys. Keys only unlock extra features.

# ── AI replies (/ai command + natural fallback chat) ───────────────────────
# PLACEHOLDER — get a free key (no credit card needed) at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Real image search results for /img (optional, PAID beyond a trial credit) ─
# PLACEHOLDER — only needed if you want /img to fetch an actual top image
# instead of a plain Google Images search link. Get a key at https://serpapi.com/
# Leave this blank to skip — /img will fall back to a search link automatically.
SERPAPI_KEY=

# Timezone used for all scheduled/cron messages
TZ=Asia/Colombo
