# Copy this file to .env and fill in what you have. Everything here is optional —
# the bot runs and connects to WhatsApp with zero keys. Keys only unlock extra features.

# ── AI replies (/ai command + natural fallback chat) ───────────────────────
# PLACEHOLDER — get a free key (no credit card needed) at:
# https://aistudio.google.com/apikey
# Comma-separated for more than one — the bot switches to the next key
# automatically once one hits its free-tier quota.
GEMINI_API_KEY=

# ── Real image search results for /img (optional, PAID beyond a trial credit) ─
# PLACEHOLDER — only needed if you want /img to fetch an actual top image
# instead of a plain Google Images search link. Get a key at https://serpapi.com/
# Leave this blank to skip — /img will fall back to a search link automatically.
SERPAPI_KEY=

# ── Spotify track links for /song (optional, free) ────────────────────────
# PLACEHOLDER — create a free app at https://developer.spotify.com/dashboard
# to get these. Leave blank to skip — /song will say it's not set up.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Owner-only group commands (optional, free) ─────────────────────────────
# PLACEHOLDER — your personal WhatsApp JID(s) (not the bot's own number). Needed
# so commands like /delete work for you specifically in any group, even when
# you're typing from your own phone(s) rather than the bot's linked number.
# Send /whoami in a group (from each number) to see its exact JID, then paste
# it here — comma-separated if you use more than one number.
OWNER_JID=

# Timezone used for all scheduled/cron messages
TZ=Asia/Colombo
